<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 父工程 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <!-- 当前整个项目 -->
    <groupId>com.byy</groupId>
    <artifactId>intelligent-meter-reading-system</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <!-- 非常重要：根工程只负责聚合，不生成 jar -->
    <packaging>pom</packaging>

    <name>intelligent-meter-reading-system</name>

    <!-- Maven 子模块 -->
    <modules>
        <module>meter-bom</module>
        <module>meter-common</module>
        <module>meter-model</module>
        <module>meter-service</module>
        <module>meter-auth</module>
        <module>meter-api</module>
        <module>meter-ai-simulator</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <meter.version>0.0.1-SNAPSHOT</meter.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <dependencyManagement>
        <dependencies>

            <!-- 引入项目 BOM -->
            <dependency>
                <groupId>com.byy</groupId>
                <artifactId>meter-bom</artifactId>
                <version>${meter.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 项目内部模块 -->
            <dependency>
                <groupId>com.byy</groupId>
                <artifactId>meter-common</artifactId>
                <version>${meter.version}</version>
            </dependency>

            <dependency>
                <groupId>com.byy</groupId>
                <artifactId>meter-model</artifactId>
                <version>${meter.version}</version>
            </dependency>

            <dependency>
                <groupId>com.byy</groupId>
                <artifactId>meter-service</artifactId>
                <version>${meter.version}</version>
            </dependency>

            <dependency>
                <groupId>com.byy</groupId>
                <artifactId>meter-auth</artifactId>
                <version>${meter.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle.xml</configLocation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <consoleOutput>true</consoleOutput>
                    <failOnViolation>true</failOnViolation>
                </configuration>
                <executions>
                    <execution>
                        <id>check-style</id>
                        <phase>validate</phase>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.9.8.3</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>High</threshold>
                    <xmlOutput>true</xmlOutput>
                    <excludeFilterFile>${maven.multiModuleProjectDirectory}/config/spotbugs-exclude.xml</excludeFilterFile>
                </configuration>
                <executions>
                    <execution>
                        <id>check-bugs</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.14</version>
                <executions>
                    <execution>
                        <goals><goal>prepare-agent</goal></goals>
                        <configuration>
                            <append>false</append>
                        </configuration>
                    </execution>
                    <execution>
                        <id>coverage-report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
