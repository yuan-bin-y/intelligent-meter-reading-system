# Copy to deploy/.env. Use unique values; never commit deploy/.env.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
DB_USERNAME=meter_app
DB_PASSWORD=replace-with-a-strong-database-password
RABBITMQ_USERNAME=meter_app
RABBITMQ_PASSWORD=replace-with-a-strong-rabbitmq-password
JWT_SECRET_BASE64=replace-with-base64-encoded-random-key
AI_SERVICE_SECRET_BASE64=replace-with-a-different-base64-encoded-random-key
OSS_ENDPOINT=replace-with-your-oss-endpoint
OSS_BUCKET_NAME=replace-with-your-oss-bucket
OSS_ACCESS_KEY_ID=replace-with-your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-your-oss-access-key-secret
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password

# Separate host ports let this stack coexist with the current Windows services.
MYSQL_PORT=3307
REDIS_PORT=6380
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_PROMETHEUS_PORT=15693
API_PORT=8071
AI_PORT=8002
WEB_PORT=8080
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001
