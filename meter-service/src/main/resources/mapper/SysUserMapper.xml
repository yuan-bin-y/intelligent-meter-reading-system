<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.byy.meterreading.mapper.SysUserMapper">

    <!-- 管理员用户列表不查询 password_hash，避免密码哈希进入列表查询结果。 -->
    <resultMap id="adminUserPageResultMap"
               type="com.byy.meterreading.model.SysUser">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="displayName" column="display_name"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="selectAdminUserPage"
            resultMap="adminUserPageResultMap">
        SELECT u.id,
               u.username,
               u.display_name,
               u.status,
               u.created_at,
               u.updated_at
        FROM sys_user AS u
        <where>
            <if test="query.username != null">
                u.username LIKE CONCAT('%', #{query.username}, '%')
            </if>
            <if test="query.status != null">
                AND u.status = #{query.status}
            </if>
            <if test="query.roleCode != null">
                AND EXISTS (
                    SELECT 1
                    FROM sys_user_role AS ur
                    INNER JOIN sys_role AS r
                            ON r.id = ur.role_id
                    WHERE ur.user_id = u.id
                      AND r.role_code = #{query.roleCode}
                      AND r.status = 1
                )
            </if>
        </where>
        ORDER BY u.created_at DESC, u.id DESC
    </select>

</mapper>
